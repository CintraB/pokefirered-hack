Help_Text_HowToUsePokedex::
	.string "{CIRCLE_1} Escolha “Pokédex” no menu.\n"
	.string "{CIRCLE_2} Escolha um Pokémon com comandos\n"
	.string "   como “Lista de Pokémon”,\n"
	.string "   “Habitats dos Pokémon” e\n"
	.string "   “Buscar”.\n"
	.string "{CIRCLE_3} Escolha um Pokémon para ver\n"
	.string "   informações detalhadas.$"

Help_Text_HowToUsePokemon::
	.string "{CIRCLE_1} Escolha “Pokémon” no menu.\n"
	.string "{CIRCLE_2} Escolha um Pokémon da sua equipe.\n"
	.string "{CIRCLE_3} Escolha “Resumo”, “Trocar”\n"
	.string "   ou “Item”.$"

Help_Text_HowToUseSummary::
	.string "{CIRCLE_1} Escolha “Resumo”.\n"
	.string "{CIRCLE_2} Aperte esquerda ou direita\n"
	.string "   no {PLUS} Direcional para ver:\n"
	.string "   “Dados”\n"
	.string "   “Atributos”\n"
	.string "   “Golpes”$"

Help_Text_HowToUseSwitch::
	.string "{CIRCLE_1} Escolha o Pokémon que quer\n"
	.string "   trocar de lugar.\n"
	.string "{CIRCLE_2} Escolha “Trocar”.\n"
	.string "{CIRCLE_3} Escolha o Pokémon com quem trocar\n"
	.string "   o primeiro.\n"
	.string "O Pokémon à esquerda da tela será\n"
	.string "o primeiro a entrar em batalha.$"

Help_Text_HowToUseItem::
	.string "{CIRCLE_1} Escolha “Item”.\n"
	.string "{CIRCLE_2} Escolha se quer “Dar” um item\n"
	.string "   para o Pokémon segurar, ou “Pegar”\n"
	.string "   o item que ele está segurando.\n"
	.string "Um Pokémon só pode segurar um item!$"

Help_Text_HowToUseBag::
	.string "{CIRCLE_1} Escolha “Bolsa” no menu.\n"
	.string "{CIRCLE_2} Aperte esquerda ou direita no\n"
	.string "   {PLUS} Direcional para ver os títulos:\n"
	.string "   “Itens”\n"
	.string "   “Itens-chave”\n"
	.string "   “Poké Bolas”\n"
	.string "   Cima ou baixo para escolher um item.$"

Help_Text_HowToUseAnItem::
	.string "{CIRCLE_1} Escolha o bolso “Itens”.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional para escolher um item.\n"
	.string "{CIRCLE_3} Escolha “Usar” para usar o item\n"
	.string "   escolhido.\n"
	.string "Alguns itens não podem ser usados,\n"
	.string "dependendo do lugar e/ou da situação.$"

Help_Text_HowToUseKeyItem::
	.string "{CIRCLE_1} Escolha o bolso “Itens-chave”.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional para escolher um\n"
	.string "   item-chave.\n"
	.string "{CIRCLE_3} Escolha “Usar” para usar o\n"
	.string "   item-chave escolhido.$"

Help_Text_HowToUsePokeBall::
	.string "{CIRCLE_1} Em batalha contra um Pokémon\n"
	.string "   selvagem, escolha o bolso\n"
	.string "   “Poké Bolas” da Bolsa.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional e escolha uma\n"
	.string "   Poké Bola.\n"
	.string "{CIRCLE_3} Escolha “Usar” para lançá-la.$"

Help_Text_HowToUsePlayer::
	.string "{CIRCLE_1} Escolha “{PLAYER}” no menu.\n"
	.string "{CIRCLE_2} Seu Cartão de Treinador aparece com\n"
	.string "   a frente para cima, com informações\n"
	.string "   básicas. Aperte o Botão A para virar\n"
	.string "   o cartão.\n"
	.string "{CIRCLE_3} O verso do cartão traz vários\n"
	.string "   dados.$"

Help_Text_HowToUseSave::
	.string "{CIRCLE_1} Escolha “Salvar” no menu.\n"
	.string "{CIRCLE_2} Escolha “Sim” e seu progresso é\n"
	.string "   gravado no arquivo de save.\n"
	.string "Depois de salvar, você pode desligar o\n"
	.string "jogo. Ele poderá ser retomado de onde\n"
	.string "você salvou.$"

Help_Text_HowToUseOption::
	.string "{CIRCLE_1} Escolha “Opções” no menu.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional para escolher uma\n"
	.string "   opção e depois aperte esquerda ou\n"
	.string "   direita para alterar os ajustes.\n"
	.string "{CIRCLE_3} Escolha “Cancelar” ou aperte o\n"
	.string "   Botão B depois de fazer as mudanças.$"

Help_Text_HowToUsePotion::
	.string "{CIRCLE_1} Abra o menu.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional e escolha “Bolsa”.\n"
	.string "{CIRCLE_3} Escolha “Poção” no bolso “Itens”.\n"
	.string "{CIRCLE_4} Escolha “Usar”.\n"
	.string "{CIRCLE_5} Escolha o Pokémon a ser curado.$"

Help_Text_HowToUseTownMap::
	.string "{CIRCLE_1} Abra o menu.\n"
	.string "{CIRCLE_2} Aperte para cima ou para baixo no\n"
	.string "   {PLUS} Direcional e escolha “Bolsa”.\n"
	.string "{CIRCLE_3} Aperte esquerda ou direita para\n"
	.string "   abrir o bolso “Itens-chave” e\n"
	.string "   escolha “Mapa da Cidade”.\n"
	.string "{CIRCLE_4} Escolha “Usar” para abrir o mapa.$"

Help_Text_HowToUseTM::
	.string "{CIRCLE_1} Abra o menu.\n"
	.string "{CIRCLE_2} Abra “Itens-chave” na “Bolsa”.\n"
	.string "{CIRCLE_3} “Abra” o Estojo de MT.\n"
	.string "{CIRCLE_4} Escolha uma MT e depois “Usar”.\n"
	.string "{CIRCLE_5} Escolha um Pokémon que possa\n"
	.string "   aprender o golpe da MT.$"

Help_Text_HowToUseHM::
	.string "{CIRCLE_1} Abra o menu.\n"
	.string "{CIRCLE_2} Abra “Itens-chave” na “Bolsa”.\n"
	.string "{CIRCLE_3} “Abra” o Estojo de MT.\n"
	.string "{CIRCLE_4} Escolha uma MO e depois “Usar”.\n"
	.string "{CIRCLE_5} Escolha um Pokémon que possa\n"
	.string "   aprendê-la.\n"
	.string "MOs são difíceis de esquecer. Cuidado!$"

Help_Text_HowToUseMoveOutsideOfBattle::
	.string "{CIRCLE_1} Abra o menu.\n"
	.string "{CIRCLE_2} Escolha “Pokémon”.\n"
	.string "{CIRCLE_3} Escolha um Pokémon que conheça um\n"
	.string "   golpe MO. Os golpes MO utilizáveis\n"
	.string "   aparecem em azul. Escolha e use o\n"
	.string "   golpe desejado para destruir um\n"
	.string "   obstáculo, voar, surfar etc.$"

Help_Text_HowToRideBicycle::
	.string "{CIRCLE_1} Abra o menu. Abra o bolso\n"
	.string "   “Itens-chave” da “Bolsa” e\n"
	.string "   escolha a “Bicicleta”.\n"
	.string "{CIRCLE_2} Para andar de bicicleta, escolha\n"
	.string "   “Usar”. Você também pode\n"
	.string "   “Registrar” a Bicicleta para usá-la\n"
	.string "   na hora apertando SELECT.$"

Help_Text_HowToEnterName::
	.string "{CIRCLE_1} Mova o cursor até a letra desejada\n"
	.string "   com o {PLUS} Direcional e aperte o\n"
	.string "   Botão A para digitá-la.\n"
	.string "{CIRCLE_2} Aperte o Botão B para voltar.\n"
	.string "{CIRCLE_3} Aperte SELECT para alternar entre\n"
	.string "   letras maiúsculas e minúsculas.\n"
	.string "{CIRCLE_4} Aperte o Botão A em “OK”.$"

Help_Text_HowToUsePC::
	.string "{CIRCLE_1} Vá a um Centro Pokémon, chegue\n"
	.string "   perto do PC e aperte o Botão A.$"

Help_Text_HowToUseBillsPC::
	.string "{CIRCLE_1} Escolha “PC de {STR_VAR_1}” no PC.\n"
	.string "{CIRCLE_2} Escolha um dos três primeiros itens\n"
	.string "   do menu para acessar o Sistema de\n"
	.string "   Armazenamento de Pokémon.\n"
	.string "Se capturar um Pokémon com seis na\n"
	.string "equipe, ele vai direto para uma Caixa\n"
	.string "do Sistema!$"

Help_Text_HowToUseWithdraw::
	.string "{CIRCLE_1} Escolha um Pokémon na Caixa aberta\n"
	.string "   com o {PLUS} Direcional.\n"
	.string "{CIRCLE_2} Escolha “Retirar” para tirar o\n"
	.string "   Pokémon da Caixa e levá-lo para\n"
	.string "   a sua equipe.\n"
	.string "Não dá para retirar um Pokémon se você\n"
	.string "já tiver seis Pokémon com você!$"

Help_Text_HowToUseDeposit::
	.string "{CIRCLE_1} Escolha um Pokémon da sua equipe\n"
	.string "   com o {PLUS} Direcional.\n"
	.string "{CIRCLE_2} Escolha “Guardar”.\n"
	.string "{CIRCLE_3} Escolha a Caixa e aperte o\n"
	.string "   Botão A para guardar o Pokémon.\n"
	.string "Se você tiver só um Pokémon com você,\n"
	.string "ele não poderá ser guardado!$"

Help_Text_HowToUseMove::
	.string "{CIRCLE_1} Escolha um Pokémon na Caixa aberta.\n"
	.string "{CIRCLE_2} Pegue o Pokémon escolhendo\n"
	.string "   “Mover” e leve-o aonde quiser com\n"
	.string "   o {PLUS} Direcional.\n"
	.string "{CIRCLE_3} Leve o Pokémon até o nome da Caixa\n"
	.string "   e aperte esquerda ou direita para\n"
	.string "   movê-lo para outra Caixa.$"

Help_Text_HowToMoveItems::
	.string "{CIRCLE_1} Um Pokémon exibido de forma\n"
	.string "   esmaecida pode receber um item:\n"
	.string "   escolha o item e aperte o Botão A.\n"
	.string "{CIRCLE_2} Um Pokémon exibido de forma nítida\n"
	.string "   pode passar o item que segura para\n"
	.string "   outro Pokémon ou devolvê-lo à Bolsa\n"
	.string "   com o Botão A.$"

Help_Text_HowToUsePlayersPC::
	.string "{CIRCLE_1} Escolha “PC de {PLAYER}” no PC.\n"
	.string "{CIRCLE_2} Escolha “Depósito de Itens” ou\n"
	.string "   “Caixa de Cartas”.\n"
	.string "Você pode guardar coisas no seu PC\n"
	.string "se a sua Bolsa estiver cheia. Também\n"
	.string "pode retirar os itens guardados no PC.$"

Help_Text_HowToUseWithdrawItem::
	.string "{CIRCLE_1} Escolha “Retirar Item”.\n"
	.string "{CIRCLE_2} Escolha o item a ser retirado.\n"
	.string "{CIRCLE_3} O item pode ser retirado e colocado\n"
	.string "   no bolso “Itens” da Bolsa. Também\n"
	.string "   pode ser dado diretamente a um\n"
	.string "   Pokémon para segurar.$"

Help_Text_HowToUseDepositItem::
	.string "{CIRCLE_1} Escolha “Guardar Item”.\n"
	.string "{CIRCLE_2} Escolha o item da Bolsa a ser\n"
	.string "   guardado com o {PLUS} Direcional.\n"
	.string "{CIRCLE_3} Se houver mais de um item a ser\n"
	.string "   guardado, informe a quantidade com\n"
	.string "   o {PLUS} Direcional e aperte o\n"
	.string "   Botão A.$"

Help_Text_HowToUseMailbox::
	.string "Ao tirar uma carta de um Pokémon, ela\n"
	.string "vai para a Caixa de Cartas. Sem cartas,\n"
	.string "a Caixa de Cartas não pode ser usada.\n"
	.string "{CIRCLE_1} Escolha “PC de {PLAYER}” no PC.\n"
	.string "{CIRCLE_2} Escolha “Caixa de Cartas” para ler\n"
	.string "   uma carta ou fazer um Pokémon\n"
	.string "   segurá-la.$"

Help_Text_HowToUseProfOaksPC::
	.string "{CIRCLE_1} Escolha “PC do Prof. Carvalho”\n"
	.string "   no PC.\n"
	.string "{CIRCLE_2} O Prof. Carvalho vai avaliar a sua\n"
	.string "   Pokédex.\n"
	.string "As avaliações dele podem dar dicas\n"
	.string "para capturar mais Pokémon!$"

Help_Text_HowToOpenMenu::
	.string "{CIRCLE_1} Aperte START.\n"
	.string "{CIRCLE_2} O menu vai abrir à direita.\n"
	.string "{CIRCLE_3} Dependendo da situação, o menu pode\n"
	.string "   ter títulos diferentes.\n"
	.string "O menu não abre em certas situações,\n"
	.string "como ao conversar, fazer algo,\n"
	.string "batalhar etc.$"

Help_Text_HowToUseFight::
	.string "{CIRCLE_1} Select “FIGHT.”\n"
	.string "{CIRCLE_2} Select one of the moves shown,\n"
	.string "and that move will be used!$"

Help_Text_HowToUsePokemon2::
	.string "{CIRCLE_1} Select “POKéMON.”\n"
	.string "{CIRCLE_2} Select the POKéMON in your party\n"
	.string "   that you want to use.\n"
	.string "{CIRCLE_3} If you have two or more POKéMON\n"
	.string "   with you, they may be switched by\n"
	.string "   selecting “SHIFT.” Check POKéMON\n"
	.string "   data by selecting “SUMMARY.”$"

Help_Text_HowToUseShift::
	.string "This command switches the POKéMON in\n"
	.string "battle with another one in your party.\n"
	.string "{CIRCLE_1} Select the POKéMON to be sent out.\n"
	.string "{CIRCLE_2} Select “SHIFT.”\n"
	.string "{CIRCLE_3} The selected POKéMON will switch\n"
	.string "   places with the POKéMON in battle!$"

Help_Text_HowToUseSummary2::
	.string "{CIRCLE_1} Select “SUMMARY.”\n"
	.string "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
	.string "   Pad to check the information:\n"
	.string "   “POKéMON INFO”\n"
	.string "   “POKéMON SKILLS”\n"
	.string "   “KNOWN MOVES”$"

Help_Text_HowToUseBag2::
	.string "{CIRCLE_1} Select “BAG.”\n"
	.string "{CIRCLE_2} Press left or right on the {PLUS} Control\n"
	.string "   Pad to check the data headings:\n"
	.string "   “ITEMS”\n"
	.string "   “KEY ITEMS”\n"
	.string "   “POKé BALLS”\n"
	.string "   Press up or down to select an item.$"

Help_Text_HowToReadPokedex::
	.string "{CIRCLE_1} POKéMON that you have caught are\n"
	.string "   identified by a POKé BALL mark on\n"
	.string "   the POKéDEX list.\n"
	.string "{CIRCLE_2} A caught POKéMON will provide a\n"
	.string "   large amount of data.\n"
	.if REVISION < 1
	.string "{CIRCLE_3} Select “AREA” to display the TOWN\n"
	.string "   MAP with the POKéMON's habitat(s).$"
	.else
	.string "{CIRCLE_3} Select “NEXT DATA” to display the\n"
	.string "   TOWN MAP with its habitat(s).$"
	.endif

Help_Text_HowToUseHomePC::
	.string "{CIRCLE_1} Go up to the PC at home, then press\n"
	.string "   the A Button.\n"
	.string "{CIRCLE_2} The PC will turn on.\n"
	.string "{CIRCLE_3} Select either “ITEM STORAGE” or\n"
	.string "   “MAILBOX.”$"

Help_Text_HowToUseItemStorage::
	.string "{CIRCLE_1} Select “WITHDRAW ITEM” to withdraw\n"
	.string "   an item stored on your PC.\n"
	.string "{CIRCLE_2} Select “DEPOSIT ITEM” to put \n"
	.string "   an item from your BAG into your PC.$"

Help_Text_HowToUseWithdrawItem2::
	.string "{CIRCLE_1} Select “WITHDRAW ITEM.”\n"
	.string "{CIRCLE_2} Select the item to be withdrawn.\n"
	.string "{CIRCLE_3} The item can be withdrawn and\n"
	.string "   placed in the BAG's ITEMS POCKET.\n"
	.string "   It may also be directly given to a\n"
	.string "   POKéMON to hold.$"

Help_Text_HowToUseDepositItem2::
	.string "{CIRCLE_1} Select “DEPOSIT ITEM.”\n"
	.string "{CIRCLE_2} Select the item in the BAG to be\n"
	.string "   deposited using the {PLUS} Control Pad.\n"
	.string "{CIRCLE_3} If there is nothing in the BAG, this\n"
	.string "   command can't be used!$"

Help_Text_HowToUseMailbox2::
	.string "When MAIL is taken from a POKéMON,\n"
	.string "it is moved to the MAILBOX. If it has\n"
	.string "no MAIL, the MAILBOX can't be used.\n"
	.string "{CIRCLE_1} Select MAIL by name to read it or\n"
	.string "   make a POKéMON hold it.$"

Help_Text_HowToUseRun::
	.string "You may not “RUN” from a TRAINER\n"
	.string "battle!\n"
	.string "{CIRCLE_1} You may “RUN” from a wild POKéMON.\n"
	.string "{CIRCLE_2} Your chance of escape is improved\n"
	.string "   if your POKéMON in battle is fast.$"

Help_Text_HowToRegisterKeyItem::
	.string "You may “REGISTER” a key item for\n"
	.string "instant use by pressing SELECT!\n"
	.string "{CIRCLE_1} Open the “KEY ITEMS” POCKET.\n"
	.string "{CIRCLE_2} Select the key item, then select\n"
	.string "   “REGISTER.”$"

Help_Text_HowToUseBall::
	.string "{CIRCLE_1} Select to throw the special POKé\n"
	.string "   BALL used only in the SAFARI ZONE.\n"
	.string "When wild POKéMON appear, throw lots\n"
	.string "of SAFARI BALLS to catch them!$"

Help_Text_HowToUseBait::
	.string "{CIRCLE_1} Select to throw the special food\n"
	.string "   used only in the SAFARI ZONE.\n"
	.string "It is POKéMON food rolled up into\n"
	.string "a ball for easy eating. When BAIT is\n"
	.string "thrown, the wild POKéMON may get\n"
	.string "attracted by it, and may not flee!$"

Help_Text_HowToUseRock::
	.string "{CIRCLE_1} Select to throw a rock lying on\n"
	.string "   the ground in the SAFARI ZONE.\n"
	.string "Throwing a rock at a POKéMON may \n"
	.string "make it run away, but it becomes easier\n"
	.string "to catch!$"

Help_Text_HowToUseHallOfFame::
	.string "{CIRCLE_1} Select “HALL OF FAME” on the PC.\n"
	.string "{CIRCLE_2} The POKéMON that have entered the\n"
	.string "   HALL OF FAME can be examined.$"

