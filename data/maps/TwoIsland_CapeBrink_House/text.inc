    .string "Este {STR_VAR_1} é digno de aprender\n"
    .string "o meu golpe supremo!\p"
    .string "Você permite?\p"
    .string "Permite que o seu {STR_VAR_1}\n"
    .string "aprenda o meu {STR_VAR_2}?$"

