Route8_Text_AidanIntro::
    .string "Você parece ter jeito com Pokémon,\n"
    .string "mas e as suas notas de química?$"

Route8_Text_AidanDefeat::
    .string "Ai!\n"
    .string "Colapso total!$"

Route8_Text_AidanPostBattle::
    .string "Eu me saio melhor na escola do que\n"
    .string "nisso!$"

Route8_Text_StanIntro::
    .string "Beleza!\n"
    .string "Vamos jogar!$"

Route8_Text_StanDefeat::
    .string "Droga!\n"
    .string "Não foi suficiente!$"

Route8_Text_StanPostBattle::
    .string "Hoje não foi o meu dia.$"

Route8_Text_GlennIntro::
    .string "Fique sabendo. É preciso ter\n"
    .string "estratégia para vencer nisto!$"

Route8_Text_GlennDefeat::
    .string "Isso não é lógico!$"

Route8_Text_GlennPostBattle::
    .string "Comece com o Grimer…e…\n"
    .string "…e…depois…$"

Route8_Text_PaigeIntro::
    .string "Eu gosto de Nidoran, por isso\n"
    .string "coleciono todos!$"

Route8_Text_PaigeDefeat::
    .string "Por quê?\n"
    .string "Por quê??$"

Route8_Text_PaigePostBattle::
    .string "Quando os Pokémon crescem, ficam\n"
    .string "feios! Eles não deviam evoluir.$"

Route8_Text_LeslieIntro::
    .string "A escola é divertida, mas os Pokémon\n"
    .string "também são.$"

Route8_Text_LeslieDefeat::
    .string "Você me deixou claro que é melhor\n"
    .string "eu ficar só com a escola.$"

Route8_Text_LesliePostBattle::
    .string "Eu pretendia tomar um ar fresco para\n"
    .string "variar, mas…\p"
    .string "Estamos presos aqui por causa dos\n"
    .string "portões da Cidade de Saffron.$"

Route8_Text_AndreaIntro::
    .string "O Meowth é tão fofo, miau, miau,\n"
    .string "miau!$"

Route8_Text_AndreaDefeat::
    .string "Miaaaau!$"

Route8_Text_AndreaPostBattle::
    .string "Acho que o Pidgey e o Rattata\n"
    .string "também são fofos!$"

Route8_Text_MeganIntro::
    .string "A gente deve estar com cara de\n"
    .string "boba, aqui parada assim.$"

Route8_Text_MeganDefeat::
    .string "Olha o que você fez com os meus\n"
    .string "pobres Pokémon fofinhos!$"

Route8_Text_MeganPostBattle::
    .string "O guarda da Cidade de Saffron não\n"
    .string "deixa a gente passar.\p"
    .string "Sei que ele está só fazendo o\n"
    .string "trabalho dele, mas acho ele malvado.$"

Route8_Text_RichIntro::
    .string "Sou um jogador andarilho!$"

Route8_Text_RichDefeat::
    .string "Perdi a grande chance!$"

Route8_Text_RichPostBattle::
    .string "Jogos e Pokémon são como comer\n"
    .string "amendoim! Não consigo parar!$"

Route8_Text_JuliaIntro::
    .string "Qual Pokémon é fofo, redondinho e\n"
    .string "felpudo?$"

Route8_Text_JuliaDefeat::
    .string "Pare!\p"
    .string "Não maltrate a minha Clefairy!$"

Route8_Text_JuliaPostBattle::
    .string "Li que a Clefairy evolui quando é\n"
    .string "exposta a uma Pedra Lunar.\p"
    .string "Li isso num Jornal Pokémon.\n"
    .string "Será que é verdade?$"

Route8_Text_UndergroundPathSign::
    .string "Via Subterrânea\n"
    .string "Cidade de Celadon -\l"
    .string "Cidade de Lavender$"

Route8_Text_EliIntro::
    .string "Eli: O poder das gêmeas é fantástico.\n"
    .string "Sabia disso?$"

Route8_Text_EliDefeat::
    .string "Eli: Mas…\n"
    .string "A gente usou o nosso poder gêmeo…$"

Route8_Text_EliPostBattle::
    .string "Eli: Eu capturei os meus Pokémon\n"
    .string "junto com a Anne!$"

Route8_Text_EliNotEnoughMons::
    .string "Eli: Não dá para lutar se você não\n"
    .string "tiver dois Pokémon.$"

Route8_Text_AnneIntro::
    .string "Anne: Vamos chocar você com o nosso\n"
    .string "poder gêmeo!$"

Route8_Text_AnneDefeat::
    .string "Anne: O nosso poder gêmeo…$"

Route8_Text_AnnePostBattle::
    .string "Anne: Estou criando Pokémon junto\n"
    .string "com a Eli.$"

Route8_Text_AnneNotEnoughMons::
    .string "Anne: Oi, oi! Vamos lutar!\n"
    .string "Mas traga dois Pokémon.$"

Route8_Text_RicardoIntro::
    .string "A minha bicicleta está dando\n"
    .string "problema.$"

Route8_Text_RicardoDefeat::
    .string "Ah, que saco.\n"
    .string "Não estou a fim disso.$"

Route8_Text_RicardoPostBattle::
    .string "Ficou mato preso nos raios da roda.$"

Route8_Text_JarenIntro::
    .string "Saia da frente, ou eu atropelo você!$"

Route8_Text_JarenDefeat::
    .string "É sério isso, criança?$"

Route8_Text_JarenPostBattle::
    .string "Não ache que é especial só por\n"
    .string "causa disso.$"
