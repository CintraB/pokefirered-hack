SafariZone_SecretHouse_Text_CongratsYouveWon::
    .string "Ah! Finalmente!\p"
    .string "Você é a primeira pessoa a chegar à\n"
    .string "Casa Secreta!\p"
    .string "Eu fiz uma campanha para a nossa\n"
    .string "grande inauguração,\p"
    .string "mas estava com receio de que ninguém\n"
    .string "ganhasse o prêmio.\p"
    .string "Parabéns!\n"
    .string "Você ganhou!$"

SafariZone_SecretHouse_Text_ReceivedHM03FromAttendant::
    .string "{PLAYER} recebeu a MO03\n"
    .string "do atendente!$"

SafariZone_SecretHouse_Text_ExplainSurf::
    .string "A MO03 é Surfar.\p"
    .string "Os Pokémon poderão levar você pela\n"
    .string "água usando esse golpe.\p"
    .string "E esta MO não é descartável, então\n"
    .string "você pode usá-la quantas vezes\l"
    .string "quiser.\p"
    .string "Você tem muita sorte de ganhar este\n"
    .string "prêmio fabuloso!$"

SafariZone_SecretHouse_Text_DontHaveRoomForPrize::
    .string "Você não tem espaço\n"
    .string "para este prêmio fabuloso!$"

