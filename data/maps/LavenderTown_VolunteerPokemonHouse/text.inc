LavenderTown_PokemonCenter_1F_Text_HearMrFujiNotFromAroundHere::
    .string "Eu me mudei para esta cidade há\n"
    .string "pouco tempo.\p"
    .string "Ouvi dizer que o Sr. Fuji também não\n"
    .string "é daqui.$"

LavenderTown_VolunteerPokemonHouse_Text_WhereDidMrFujiGo::
    .string "Que estranho, o Sr. Fuji não está\n"
    .string "aqui. Aonde ele foi?$"

LavenderTown_VolunteerPokemonHouse_Text_MrFujiWasPrayingForCubonesMother::
    .string "O Sr. Fuji estava rezando sozinho\n"
    .string "pela mãe do Cubone.$"

LavenderTown_VolunteerPokemonHouse_Text_MrFujiLooksAfterOrphanedMons::
    .string "Esta é mesmo a casa do Sr. Fuji.\p"
    .string "Ele é muito bondoso.\p"
    .string "Ele cuida de Pokémon abandonados e\n"
    .string "órfãos.$"

LavenderTown_VolunteerPokemonHouse_Text_MonsNiceToHug::
    .string "Que quentinho!\n"
    .string "É tão bom abraçar um Pokémon.$"

LavenderTown_VolunteerPokemonHouse_Text_Nidorino::
    .string "Nidorino: Gaoo!$"

LavenderTown_VolunteerPokemonHouse_Text_Psyduck::
    .string "Psyduck: Gwappa!$"

LavenderTown_VolunteerPokemonHouse_Text_IdLikeYouToHaveThis::
    .string "Sr. Fuji: {PLAYER}…\p"
    .string "A sua jornada pela Pokédex exige\n"
    .string "muita dedicação.\p"
    .string "Sem um amor profundo pelos Pokémon,\n"
    .string "ela pode fracassar.\p"
    .string "Não sei se vai ajudar, mas gostaria\n"
    .string "que você ficasse com isto.$"

LavenderTown_VolunteerPokemonHouse_Text_ReceivedPokeFluteFromMrFuji::
    .string "{PLAYER} recebeu a Poké Flauta do\n"
    .string "Sr. Fuji.$"

LavenderTown_VolunteerPokemonHouse_Text_ExplainPokeFlute::
    .string "Ao ouvir a Poké Flauta, Pokémon\n"
    .string "adormecidos despertam de repente.\p"
    .string "Tente usá-la em Pokémon que\n"
    .string "bloqueiam o caminho enquanto dormem.$"

LavenderTown_VolunteerPokemonHouse_Text_MustMakeRoomForThis::
    .string "Você precisa abrir espaço para isto!$"

LavenderTown_VolunteerPokemonHouse_Text_HasPokeFluteHelpedYou::
    .string "Sr. Fuji: A minha Poké Flauta ajudou\n"
    .string "você?$"

LavenderTown_VolunteerPokemonHouse_Text_GrandPrizeDrawingClipped::
    .string "Revista Fã de Pokémon\n"
    .string "Sorteio Mensal do Grande Prêmio!\p"
    .string "O formulário de inscrição…\p"
    .string "Sumiu! Foi recortado.\n"
    .string "Alguém já deve ter se inscrito.$"

LavenderTown_VolunteerPokemonHouse_Text_PokemonMagazinesLineShelf::
    .string "Revistas Pokémon enchem a estante.\p"
    .string "Pokémon por Dentro…\p"
    .string "Fã de Pokémon…$"

