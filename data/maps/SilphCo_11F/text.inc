SilphCo_11F_Text_ObtainedMasterBallFromPresident::
    .string "{PLAYER} obteve uma Bola Mestra\n"
    .string "do Presidente!$"

SilphCo_11F_Text_ThatsOurSecretPrototype::
    .string "Presidente: Isso você não compra em\n"
    .string "lugar nenhum.\p"
    .string "É o nosso protótipo secreto da\n"
    .string "Bola Mestra.\p"
    .string "Ela captura qualquer Pokémon sem\n"
    .string "falhar!\p"
    .string "Mas é melhor usá-la com discrição.$"

SilphCo_11F_Text_YouHaveNoRoomForThis::
    .string "Você não tem espaço para isto.$"

SilphCo_11F_Text_ThanksForRescuingUs::
    .string "Secretária: Obrigada por nos\n"
    .string "resgatar.\p"
    .string "Todos nós, do Presidente para baixo,\n"
    .string "estamos em dívida com você.$"

SilphCo_11F_Text_GiovanniIntro::
    .string "Ah, {PLAYER}!\n"
    .string "Nos encontramos de novo!\p"
    .string "O Presidente e eu estamos discutindo\n"
    .string "uma proposta de negócios vital.\p"
    .string "Não se meta em assuntos de gente\n"
    .string "grande…\p"
    .string "Ou conhecerá um mundo de dor!$"

SilphCo_11F_Text_GiovanniDefeat::
    .string "Arrgh!!\n"
    .string "Perdi de novo!?$"

SilphCo_11F_Text_GiovanniPostBattle::
    .string "Maldição!\n"
    .string "Você arruinou os nossos planos para a\l"
    .string "Silph!\p"
    .string "Mas a Equipe Rocket jamais cairá!\p"
    .string "{PLAYER}! Nunca se esqueça:\n"
    .string "todos os Pokémon existem para a\l"
    .string "Equipe Rocket!\p"
    .string "Preciso ir, mas voltarei!$"

