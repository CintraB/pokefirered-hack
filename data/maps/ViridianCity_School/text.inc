ViridianCity_School_Text_TryingToMemorizeNotes::
    .string "Ufa! Estou tentando memorizar todas\n"
    .string "as minhas anotações.$"

ViridianCity_School_Text_ReadBlackboardCarefully::
    .string "Certo!\p"
    .string "Leiam com atenção o que está no\n"
    .string "quadro-negro!$"

ViridianCity_School_Text_NotebookFirstPage::
    .string "Vamos dar uma olhada no caderno.\p"
    .string "Primeira página…\p"
    .string "As Poké Bolas são usadas para\n"
    .string "capturar Pokémon.\p"
    .string "É possível levar até seis Pokémon no\n"
    .string "grupo.\p"
    .string "Quem cria Pokémon e batalha com eles\n"
    .string "é chamado de Treinador.$"

ViridianCity_School_Text_NotebookSecondPage::
    .string "Segunda página…\p"
    .string "Um Pokémon saudável pode ser difícil\n"
    .string "de capturar, então enfraqueça-o\l"
    .string "primeiro.\p"
    .string "Envenene, queime ou cause outro\n"
    .string "problema de status para\l"
    .string "enfraquecê-lo.$"

ViridianCity_School_Text_NotebookThirdPage::
    .string "Terceira página…\p"
    .string "Os Treinadores Pokémon procuram\n"
    .string "outros para travar batalhas Pokémon.\p"
    .string "Para os Treinadores, o gosto da\n"
    .string "vitória é realmente doce.\p"
    .string "Batalhas são travadas o tempo todo\n"
    .string "nos Ginásios Pokémon do mundo todo.$"

ViridianCity_School_Text_NotebookFourthPage::
    .string "Quarta página…\p"
    .string "O objetivo final de todo\n"
    .string "Treinador Pokémon é simples.\p"
    .string "É derrotar os oito principais\n"
    .string "Líderes de Ginásio Pokémon.\p"
    .string "Faça isso para ganhar o direito de\n"
    .string "enfrentar…\p"
    .string "A Elite Quatro da Liga Pokémon!$"

ViridianCity_School_Text_TurnThePage::
    .string "Virar a página?$"

ViridianCity_School_Text_HeyDontLookAtMyNotes::
    .string "Menina: Ei!\n"
    .string "Não olhe as minhas anotações!$"

ViridianCity_School_Text_BlackboardListsStatusProblems::
    .string "O quadro-negro lista os\n"
    .string "problemas de status dos Pokémon\l"
    .string "durante as batalhas.$"

ViridianCity_School_Text_ReadWhichTopic::
    .string "Qual tópico você quer ler?$"

ViridianCity_School_Text_ExplainSleep::
    .string "Um Pokémon adormecido não pode\n"
    .string "atacar.\p"
    .string "Os Pokémon continuam dormindo mesmo\n"
    .string "depois das batalhas.\p"
    .string "Use Despertar para acordar um\n"
    .string "Pokémon que esteja dormindo.$"

ViridianCity_School_Text_ExplainBurn::
    .string "Uma queimadura reduz o poder de\n"
    .string "Ataque. Ela também causa perda\l"
    .string "contínua de PS.\p"
    .string "A queimadura continua depois da\n"
    .string "batalha. Use Cura Queimadura para\l"
    .string "curá-la.$"

ViridianCity_School_Text_ExplainPoison::
    .string "Quando um Pokémon é envenenado, a\n"
    .string "saúde dele cai aos poucos.\p"
    .string "O veneno continua depois das\n"
    .string "batalhas. Use um Antídoto para curar\l"
    .string "o veneno!$"

ViridianCity_School_Text_ExplainFreeze::
    .string "Um Pokémon congelado fica\n"
    .string "completamente imóvel.\p"
    .string "Ele continua congelado mesmo depois\n"
    .string "que a batalha termina.\p"
    .string "Use Descongelar para descongelar o\n"
    .string "Pokémon que está sofrendo.$"

ViridianCity_School_Text_ExplainParalysis::
    .string "A paralisia reduz a Velocidade e\n"
    .string "pode impedir o Pokémon de se mover.\p"
    .string "A paralisia continua depois das\n"
    .string "batalhas. Use Antiparalisia para o\l"
    .string "tratamento.$"

