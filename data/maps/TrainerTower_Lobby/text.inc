@ All Trainer Tower text (Lobby and Roof) is interleaved here

TrainerTower_Lobby_Text_WelcomeToTrainerTower::
    .string "Olá!\p"
    .string "Boas-vindas à Torre do Treinador,\n"
    .string "ponto de encontro de Treinadores do\l"
    .string "mundo todo!$"

TrainerTower_Lobby_Text_TrainersUpToFloorNum::
    .string "Treinadores do mundo inteiro se\n"
    .string "reúnem aqui para batalhar.\p"
    .string "Deixe-me ver…\p"
    .string "Por enquanto, há Treinadores só\n"
    .string "até o {STR_VAR_1}º andar.$"

TrainerTower_Lobby_Text_TrainersUpEighthFloor::
    .string "Há Treinadores esperando pelo seu\n"
    .string "desafio até o oitavo andar.$"

TrainerTower_Lobby_Text_LikeToChallengeTrainers::
    .string "Gostaria de desafiar os Treinadores\n"
    .string "que estão esperando?$"

TrainerTower_Lobby_Text_StartClockGetSetGo::
    .string "Certo, vou iniciar o relógio, então\n"
    .string "dê tudo de si.\p"
    .string "Em suas marcas…\p"
    .string "Preparar…\p"
    .string "Já!$"

TrainerTower_Lobby_Text_PleaseVisitUsAgain::
    .string "Volte sempre!$"

TrainerTower_Lobby_Text_TooBadComeBackTryAgain::
    .string "Que pena.\p"
    .string "Acho que você se esforçou muito nas\n"
    .string "batalhas.\p"
    .string "Volte e tente de novo!$"

TrainerTower_Lobby_Text_GiveItYourBest::
    .string "Espero que você dê o seu melhor.$"

TrainerTower_Lobby_Text_MoveCounterHereWhenTrainersSwitch::
    .string "Quando os Treinadores trocam de\n"
    .string "lugar, a movimentação fica caótica.\p"
    .string "Para evitar a correria, mudamos o\n"
    .string "balcão de recepção para cá.\p"
    .string "Desculpe o incômodo.$"

TrainerTower_Roof_Text_ImOwnerBattledPerfectly::
    .string "Olá…\p"
    .string "Eu sou o dono desta Torre…\p"
    .string "Como o céu se eleva sobre este\n"
    .string "terraço…\p"
    .string "A carícia dos ventos aqui em cima…\p"
    .string "Tudo é tão perfeito…\p"
    .string "O seu modo de batalhar…\n"
    .string "Também foi perfeito…$"

TrainerTower_Roof_Text_ThisIsForYou::
    .string "Isto é para você…$"

TrainerTower_Roof_Text_DoneItInRecordTime::
    .string "Oh!\n"
    .string "Estupendo!\p"
    .string "É maravilhoso ver como você chegou\n"
    .string "aqui em cima tão depressa.\p"
    .string "O fato é que você fez isso em\n"
    .string "tempo recorde…\p"
    .string "Vou mandar afixar o seu recorde no\n"
    .string "balcão de recepção.$"

TrainerTower_Roof_Text_TookSweetTimeGettingHere::
    .string "Parece que você levou todo o tempo\n"
    .string "do mundo para chegar aqui…$"

TrainerTower_Roof_Text_IdLikeToSeeBetterTime::
    .string "O que eu gostaria de ver é um tempo\n"
    .string "melhor da sua parte…\p"
    .string "Estou contando com você.\p"
    .string "Até lá, adeus…$"

TrainerTower_Text_XMinYZSec::
    .string "{STR_VAR_1} min {STR_VAR_2},{STR_VAR_3} s$"

TrainerTower_Lobby_Text_HereAreTheResults::
    .string "せいせきひょうです$"

TrainerTower_Lobby_Text_NeedTwoMonsForDouble::
    .string "Esta é uma batalha dupla.\p"
    .string "Você só pode batalhar se tiver pelo\n"
    .string "menos dois Pokémon.$"

TrainerTower_Lobby_Text_ExplainTrainerTower::
    .string "Aqui na Torre do Treinador, há um\n"
    .string "evento chamado Contra-Relógio.\p"
    .string "O seu tempo será cronometrado desde\n"
    .string "o balcão de recepção até o dono da\l"
    .string "Torre, no terraço.\p"
    .string "Os melhores tempos ficarão\n"
    .string "registrados no Quadro de Tempos.\p"
    .string "Tente competir com os amigos para\n"
    .string "ver quem consegue o menor tempo.\p"
    .string "Aqui, vencer Treinadores não rende\n"
    .string "PE nem dinheiro.$"

TrainerTower_Lobby_Text_ThanksForCompeting::
    .string "Agradecemos por competir!$"

TrainerTower_Lobby_Text_WonderWhatKindsOfTrainers::
    .string "Vim ver o quanto eu sou boa.\p"
    .string "Que tipo de Treinadores estarão\n"
    .string "me esperando?\p"
    .string "Estou uma pilha de nervos!$"

TrainerTower_Lobby_Text_StairsTougherThanAnyBattle::
    .string "Ufa, ufa…\n"
    .string "Ufa…\p"
    .string "Esqueça as batalhas! Estas escadas…\n"
    .string "São mais duras que qualquer batalha…$"

