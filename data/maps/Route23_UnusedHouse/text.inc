@ POK-51: textos do 1º andar e os comuns aos andares do prédio da Família Sombra.
FamiliaSombra_Text_CapangaIntro::
    .string "O capanga de chapéu te encara.\n"
    .string "Quem sobe sem convite paga caro.$"

FamiliaSombra_Text_CapangaDerrota::
    .string "O capanga ajeita o chapéu e\n"
    .string "some nas sombras.$"

FamiliaSombra_Text_Maleta2000::
    .string "Você achou ¥2.000 numa maleta!$"

FamiliaSombra_Text_Maleta3000::
    .string "Você achou ¥3.000 numa maleta!$"

FamiliaSombra_Text_Maleta5000::
    .string "Você achou ¥5.000 numa maleta!$"

FamiliaSombra_Text_Maleta10000::
    .string "Você achou ¥10.000 numa maleta!$"

Route23_UnusedHouse_Text_Bilhete1::
    .string "Um bilhete pregado na mesa:\n"
    .string "“Regras da casa.\p"
    .string "Um: nunca tome partido contra\n"
    .string "a Família.\p"
    .string "Dois: quem pede um favor ao Dom\n"
    .string "não recusa o que ele pedir depois.”$"

Route23_UnusedHouse_Text_Bilhete2::
    .string "Um bilhete novo, por cima do velho:\n"
    .string "“O Dom caiu. Agora quem manda é\p"
    .string "TYRANITAR, O COBRADOR.\n"
    .string "Quem deve, paga. Quem não deve,\l"
    .string "vai dever.”$"

Route23_UnusedHouse_Text_Bilhete3::
    .string "Mais um bilhete, em letra miúda:\n"
    .string "“Regra nova: contrato é contrato.\p"
    .string "GARCHOMP, O MERCENÁRIO, veio de\n"
    .string "Sinnoh. Não é família: cobra\l"
    .string "adiantado.”$"

Route23_UnusedHouse_Text_Bilhete4::
    .string "Um bilhete amarelado, mais velho\n"
    .string "que as regras da casa:\p"
    .string "“Nunca tome partido contra a\n"
    .string "Família. Nem contra DARKRAI, O\l"
    .string "PESADELO.”$"
